<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Pawnsmith.Infrastructure</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Pawnsmith.Application\Pawnsmith.Application.csproj" />
    <ProjectReference Include="..\Pawnsmith.Domain\Pawnsmith.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- DEC-115 - pinned on 6.2.4, the last MIT release: from 6.5.0 on,
         PDFsharp is published under AGPL-3.0-only. Never bump it. -->
    <PackageReference Include="PDFsharp" Version="6.2.4" />

    <!-- DEC-115 - not used by this code. PDFsharp 6.2.4 asks for 8.0.1, which
         carries two advisories (GHSA-846f-f764-76mx, GHSA-2fmv-rv2c-59x7),
         and a direct reference is how NuGet lets a project raise a transitive
         version. 10.0.15 rather than 8.0.2, the other fixed release: .NET 8
         left support in November 2026 and gets no further fixes, while the
         10.0 line is the LTS this solution targets. PDFsharp only asks for a
         minimum, so the higher version satisfies it. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.15" />

    <PackageReference Include="Serilog" Version="4.4.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>

  <!-- The sheet font, embedded so the same PDF comes out of Windows, the Linux
       container and CI. PDFsharp has no fonts of its own and no access to
       system fonts. -->
  <ItemGroup>
    <EmbeddedResource Include="Fonts\DejaVuSans.ttf" />
  </ItemGroup>

</Project>
