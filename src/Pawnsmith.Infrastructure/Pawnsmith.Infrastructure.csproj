<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Pawnsmith.Infrastructure</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Pawnsmith.Application\Pawnsmith.Application.csproj" />
    <ProjectReference Include="..\Pawnsmith.Domain\Pawnsmith.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="PDFsharp" Version="6.2.4" />
    <PackageReference Include="Serilog" Version="4.4.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>

  <!-- The sheet font, embedded so the same PDF comes out of Windows, the Linux
       container and CI. PDFsharp has no fonts of its own and no access to
       system fonts. -->
  <ItemGroup>
    <EmbeddedResource Include="Fonts\DejaVuSans.ttf" />
  </ItemGroup>

</Project>
