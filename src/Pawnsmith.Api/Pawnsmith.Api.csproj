<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Pawnsmith.Api</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Pawnsmith.Application\Pawnsmith.Application.csproj" />
    <ProjectReference Include="..\Pawnsmith.Domain\Pawnsmith.Domain.csproj" />
    <ProjectReference Include="..\Pawnsmith.Infrastructure\Pawnsmith.Infrastructure.csproj" />
  </ItemGroup>

  <!-- DEC-090 - the bridge between ASP.NET's ILogger<T> and Serilog. The API
       also uses Serilog.Context.LogContext, from the Serilog package this one
       depends on and Pawnsmith.Infrastructure references explicitly; the
       version is the one Infrastructure pins. -->
